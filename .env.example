# Copy to .env and fill in real values. Never commit .env.
# Shared across all model/environment deployments run from this repo checkout.
VLLM_API_KEY=
# Required — all three models (gemma-3-1b-it, medgemma-4b, medgemma-27b) are
# gated on Hugging Face; your HF account must accept Google's license/usage
# terms on each model page before this token can download it.
HUGGING_FACE_HUB_TOKEN=
