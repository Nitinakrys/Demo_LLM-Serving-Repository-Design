ENVIRONMENT=prod
GPU_TYPE=H200
GPU_COUNT=1
LOG_LEVEL=WARNING

# Same TP (fits on 1 GPU either way), but H200's much larger HBM lets us
# raise context length, batching, and concurrency well past what the L40S
# deployments in dev/qa can safely hold.
TENSOR_PARALLEL_SIZE=1
DTYPE=bfloat16
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=256
MAX_NUM_BATCHED_TOKENS=32768
