ENVIRONMENT=prod
GPU_TYPE=H200
GPU_COUNT=1
LOG_LEVEL=WARNING

# Same TP, but H200 headroom lets prod run a much larger context window,
# higher concurrency, and more images per request than the L40S dev/qa tier.
TENSOR_PARALLEL_SIZE=1
DTYPE=bfloat16
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=128
MAX_NUM_BATCHED_TOKENS=16384
LIMIT_MM_PER_PROMPT={"image": 8}
