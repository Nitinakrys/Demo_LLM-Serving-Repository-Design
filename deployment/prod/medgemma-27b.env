ENVIRONMENT=prod
GPU_TYPE=H200
GPU_COUNT=1
LOG_LEVEL=WARNING

# The biggest divergence in this whole config set: a single H200 has 141GB
# HBM3e, so the ~54GB of BF16 weights fit on ONE GPU with plenty of room
# left for KV cache — tensor parallelism is no longer needed at all.
# Dropping TP 2 -> 1 here isn't just a tuning knob, it changes how many
# GPUs this deployment consumes per replica.
TENSOR_PARALLEL_SIZE=1
DTYPE=bfloat16
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=16384
LIMIT_MM_PER_PROMPT={"image": 8}
